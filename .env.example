# Opción A: API de Anthropic
ANTHROPIC_API_KEY=
# Opción B: OpenRouter
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=sk-or-...
# CHAT_MODEL=anthropic/claude-haiku-5.5
# Límites del asistente (por defecto 20 preguntas por hora por IP y 500 al día en total)
# CHAT_PER_HOUR=20
# CHAT_PER_DAY=500
# Alertas push: genera las claves con `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu@correo.com
# Carpeta donde se guardan las suscripciones (en Docker es un volumen)
# DATA_DIR=.data

# Cuentas (opcionales para los usuarios)
# URL pública de la app: se usa en los enlaces de los correos y en el regreso de Google. Obligatoria en producción.
# APP_URL=https://courtside.tudominio.com
# Correos que quedan como administradores al confirmar su correo (separados por coma)
# ADMIN_EMAILS=tu@correo.com
# Correo saliente (verificación y recuperación de clave). En desarrollo, sin esto se imprime en la consola.
# SMTP_URL=smtp://usuario:clave@smtp.servidor.com:587
# MAIL_FROM=CourtSide <no-reply@tudominio.com>
# Entrar con Google: credenciales OAuth de Google Cloud Console
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
